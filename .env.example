# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=knowledge_universe
POSTGRES_USER=ku_user
POSTGRES_PASSWORD=ku_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# LLM (Provide your API key to enable Tier 2/3 understanding and placement)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Concurrency & Performance
WORKER_MAX_JOBS=10
EXPANSION_MAX_FANOUT=100

ENVIRONMENT=development
LOG_LEVEL=INFO
