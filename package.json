{
  "name": "memory-palace",
  "private": true,
  "type": "module",
  "description": "A walkable, realistic 3D world of architecture. The site is static ES modules; Node is only for tests, checks and offline baking.",
  "scripts": {
    "serve": "node tools/serve.mjs",
    "check": "node tools/plan-check.mjs",
    "bake": "node tools/bake.mjs",
    "shot": "node tools/shot.mjs",
    "budget": "node tools/budget.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "walk": "node tools/walk-check.mjs",
    "audio": "node tools/audio-check.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "three": "0.186.1",
    "three-mesh-bvh": "^0.9.0",
    "pngjs": "^7.0.0",
    "pixelmatch": "^6.0.0"
  }
}
